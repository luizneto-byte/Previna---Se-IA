# Preencha com a chave do provedor (somente servidor, nunca NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Crie uma senha longa para ativar o modo Luiz
ADMIN_PASSWORD=
# Segredo aleatório de pelo menos 32 caracteres para assinar a sessão
SESSION_SECRET=
# Opcional: URL do seu endpoint EXISTENTE de ISA, compatível com JSON {messages, isAdmin}
# Se configurar, o app chama esse backend no lugar da Gemini.
ISA_API_URL=
# Se ISA_API_URL estiver preenchido, configure o token do seu backend para autenticar a chamada
ISA_API_TOKEN=
